  "license": "ISC",
  "dependencies": {
    "crypto-js": "^4.2.0",
    "express": "^4.21.2",
    "got": "^14.4.6",
    "sinon": "^19.0.2"
  },
  "devDependencies": {
    "@types/chai": "^5.0.1",
    "@types/express": "^5.0.0",
    "@types/got": "^9.6.12",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.1",
    "@types/sinon": "^17.0.3",
    "chai": "^5.1.2",
    "mocha": "^11.1.0",
    "nock": "^14.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
