{
  "name": "nodefileparseringemark",
  "version": "1.0.0",
  "description": "File parsing for urls and making requests towards them",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --no-warnings --loader=ts-node/esm --experimental-specifier-resolution=node node_modules/mocha/bin/mocha src/test/**/*.test.ts"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
